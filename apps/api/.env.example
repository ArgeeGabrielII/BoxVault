# ==================================================
# BOXVAULT API — MANUAL DEVELOPMENT PLACEHOLDERS
# Prefer pnpm dev:local for the isolated loopback app.
# AWS hosted target: Sydney, single API instance, Single-AZ RDS.
# Hosted secrets resolve at runtime; daily DB rotation requires connection refresh.
# See docs/architecture/aws-platform-decision.md and docs/deployment/secret-rotation.md.
# ==================================================

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# ==================================================
# AWS RDS POSTGRESQL / LOCAL MANUAL DATABASE
# All three connections target the same approved database with different roles.
# Preserve historical Neon branches; they are not the default AWS target.
# ==================================================

# Restricted tenant/content runtime user (Prisma pool)
DATABASE_URL="postgresql://CONTENT_RUNTIME:PASSWORD@RDS_PRIVATE_ENDPOINT:5432/boxvault?sslmode=require"

# Migration/admin user (direct connection only)
DIRECT_URL="postgresql://MIGRATION_USER:PASSWORD@RDS_PRIVATE_ENDPOINT:5432/boxvault?sslmode=require"

# Restricted authentication service user (separate Prisma pool)
AUTH_DATABASE_URL="postgresql://AUTH_RUNTIME:PASSWORD@RDS_PRIVATE_ENDPOINT:5432/boxvault?sslmode=require"

# ==================================================
# AUTHENTICATION & SESSION SECURITY
# Do not blindly rotate these values daily. JWT/pepper/TOTP require version-aware code.
# ==================================================

# At least 32 random characters each
AUTH_SESSION_PEPPER=<32_RANDOM_CHAR>
AUTH_ACCESS_JWT_KEY=<32_RANDOM_CHAR>

# Base64-encoded 32-byte AES key
TOTP_ENCRYPTION_KEY=<32-byte AES key>

# ==================================================
# GOOGLE SIGN-IN
# ==================================================

GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ==================================================
# AWS SES SMTP COMPATIBILITY
# Current code is SMTP-only. SES API with temporary IAM credentials is the target;
# that transport and its deployment role are not implemented by this sample.
# ==================================================

SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=SES_REGIONAL_SMTP_USERNAME
SMTP_PASSWORD=
SMTP_FROM="BoxVault Development <no-reply@example.invalid>"

# HTTPS is currently required by the backend outside CI
PUBLIC_WEB_URL=https://replace-with-your-web-domain.example

# ==================================================
# CURRENT CAPTCHA INTEGRATION
# Cloud UI must supply valid proofs, or an AWS WAF replacement must be implemented.
# Never bypass production bot protection by changing NODE_ENV to test.
# ==================================================

RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=localhost
AUTH_BOT_PROTECTION_MODE=enforce
