# ==================================================
# BOXVAULT API — LOCAL DEVELOPMENT
# ==================================================

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# ==================================================
# NEON POSTGRESQL
# All three connections must target the test branch
# ==================================================

# Restricted tenant/content runtime user (pooled)
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DBNAME?sslmode=require"

# Migration/admin user (direct connection only)
DIRECT_URL="postgresql://USER:PASSWORD@POOLED_HOST/DBNAME?sslmode=require"

# Restricted authentication service user (pooled)
AUTH_DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DBNAME?sslmode=require"

# ==================================================
# AUTHENTICATION & SESSION SECURITY
# ==================================================

# At least 32 random characters each
AUTH_SESSION_PEPPER=<32_RANDOM_CHAR>
AUTH_ACCESS_JWT_KEY=<32_RANDOM_CHAR>

# Base64-encoded 32-byte AES key
TOTP_ENCRYPTION_KEY=<32-byte AES key>

# ==================================================
# GOOGLE SIGN-IN
# ==================================================

GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ==================================================
# BREVO SMTP
# ==================================================

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=123456890@smtp-brevo.com
SMTP_PASSWORD=
SMTP_FROM="BoxVault Development <VERIFIED_EMAIL_ADDRESS@gmail.com>"

# HTTPS is currently required by the backend outside CI
PUBLIC_WEB_URL=https://replace-with-your-web-domain.example

# ==================================================
# GOOGLE RECAPTCHA V3
# ==================================================

RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAME=localhost
AUTH_BOT_PROTECTION_MODE=enforce
