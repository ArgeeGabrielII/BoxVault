## Neon project shiny-field-66278071 (org-purple-surf-16785136)
## Set actual credentials ONLY in apps/api/.env or a secrets manager.
## Runtime: pooled (-pooler endpoint); migrations: direct/non-pooled endpoint.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DBNAME?sslmode=require"
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Authentication (examples only; configure via secret manager in production)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
RECAPTCHA_SECRET_KEY=
TOTP_ENCRYPTION_KEY=
AUTH_SESSION_PEPPER=
AUTH_ACCESS_JWT_KEY=
# Separate least-privileged DB role for identity/session/MFA tables.
AUTH_DATABASE_URL=
# The 32-byte AES key above must be base64 encoded and managed as a secret.
