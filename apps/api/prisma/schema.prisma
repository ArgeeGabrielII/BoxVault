generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum ContainerShareMode {
  PRIVATE
  SELECTED_MEMBERS
  ALL_FAMILY
}

enum ContainerGrantPermission {
  VIEW
  EDIT
}

enum AuthProvider {
  GOOGLE
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum SubscriptionStatus {
  INACTIVE
  ACTIVE
  EXPIRED
  CANCELED
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  REVERSAL
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  passwordHash String?
  emailVerifiedAt DateTime?
  createdAt    DateTime       @default(now())
  memberships  TenantMember[]
  authIdentities AuthIdentity[]
  totpFactor     TotpFactor?
  recoveryCodes  MfaRecoveryCode[]
  authSessions   AuthSession[]
  authChallenges AuthChallenge[]
  emailTokens EmailActionToken[]
  auditEvents AuthAuditEvent[]
  platformOperator PlatformOperator?
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime       @default(now())
  members       TenantMember[]
  containers    Container[]
  subscriptions Subscription[]
  wallet        CreditWallet?
  topups        TopupRequest[]
}

model TenantMember {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  userId    String         @db.Uuid
  role      MembershipRole
  status    MembershipStatus @default(ACTIVE)
  ownedContainers Container[] @relation("OwnedContainerMembership")
  accessReceived ContainerAccessGrant[] @relation("AccessGranteeMembership")
  accessGiven ContainerAccessGrant[] @relation("AccessGrantorMembership")
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  user      User           @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
}

model Container {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  publicToken String      @unique
  name        String
  location    String?
  createdAt   DateTime    @default(now())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  ownerUserId String      @db.Uuid
  ownerMembership TenantMember @relation("OwnedContainerMembership", fields: [tenantId, ownerUserId], references: [tenantId, userId], onDelete: NoAction, onUpdate: NoAction, map: "Container_owner_user_membership_fkey")
  shareMode   ContainerShareMode @default(PRIVATE)
  accessGrants ContainerAccessGrant[]
  items       Item[]
  media       MediaAsset[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([tenantId, ownerUserId])
}

model ContainerAccessGrant {
  id          String @id @default(uuid()) @db.Uuid
  tenantId    String @db.Uuid
  containerId String @db.Uuid
  granteeUserId String @db.Uuid
  permission ContainerGrantPermission
  grantedBy   String @db.Uuid
  granteeMembership TenantMember @relation("AccessGranteeMembership", fields: [tenantId, granteeUserId], references: [tenantId, userId], onDelete: NoAction, onUpdate: NoAction, map: "ContainerAccessGrant_grantee_membership_fkey")
  grantorMembership TenantMember @relation("AccessGrantorMembership", fields: [tenantId, grantedBy], references: [tenantId, userId], onDelete: NoAction, onUpdate: NoAction, map: "ContainerAccessGrant_grantor_membership_fkey")
  revokedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  container   Container @relation(fields: [containerId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([containerId, granteeUserId])
  @@index([tenantId, granteeUserId, revokedAt])
  @@index([containerId, revokedAt])
}

model Item {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  containerId String    @db.Uuid
  name        String
  quantity    Int       @default(1)
  container   Container @relation(fields: [containerId, tenantId], references: [id, tenantId])

  @@index([tenantId, containerId])
}

model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  containerId String    @db.Uuid
  objectKey   String
  mimeType    String
  byteSize    Int
  container   Container @relation(fields: [containerId, tenantId], references: [id, tenantId])

  @@index([tenantId, containerId])
}

model Plan {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  annualCredits Int
  maxMembers    Int
  maxContainers Int
  maxStorageMb  Int
  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  planId     String             @db.Uuid
  status     SubscriptionStatus @default(INACTIVE)
  validUntil DateTime?
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  plan       Plan               @relation(fields: [planId], references: [id])

  @@index([tenantId, status])
}

model CreditWallet {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @unique @db.Uuid
  balance    Int           @default(0)
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  entries    CreditEntry[]
}

model CreditEntry {
  id          String          @id @default(uuid()) @db.Uuid
  walletId    String          @db.Uuid
  type        LedgerEntryType
  amount      Int
  referenceId String          @unique
  createdAt   DateTime        @default(now())
  wallet      CreditWallet    @relation(fields: [walletId], references: [id])
}

model TopupRequest {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  amountPhp   Int
  credits     Int
  status      TopupStatus @default(PENDING)
  bankRef     String?
  proofKey    String?
  reviewedBy  String?     @db.Uuid
  reviewedAt  DateTime?
  createdAt   DateTime    @default(now())
  tenant      Tenant      @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

 // Authentication schema foundation only. No production authentication service is implemented.
 // All secret ciphertext must use application-level authenticated encryption and managed keys.
model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
}

model TotpFactor {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  secretCiphertext  String
  encryptionKeyId   String
  enabledAt         DateTime?
  pendingExpiresAt  DateTime?
  lastUsedStep      BigInt?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  codeHash    String    @unique
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  refreshTokenHash   String    @unique
  expiresAt          DateTime
  revokedAt          DateTime?
  mfaAuthenticatedAt DateTime?
  privilegedStepUpAt DateTime?
  createdAt          DateTime  @default(now())
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}


// Single-purpose, short-lived, durable pre-auth TOTP challenge.
model AuthChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, consumedAt, expiresAt])
}

enum EmailActionKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum PlatformRole {
  PAYMENT_REVIEWER
  OPERATIONS_ADMIN
  SECURITY_ADMIN
}

model EmailActionToken {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  kind       EmailActionKind
  tokenHash  String @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, usedAt, expiresAt])
}

model AuthRateLimit {
  key        String @id
  count      Int @default(0)
  windowEnds DateTime
}

model AuthAuditEvent {
  id        String @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  kind      String
  occurredAt DateTime @default(now())
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
}

model PlatformOperator {
  userId String @id @db.Uuid
  role PlatformRole
  enabled Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
