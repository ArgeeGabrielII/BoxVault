{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "backend/src/**/*.tsx",
    "backend/src/**/*.ts",
    "qr/src/**/*.tsx",
    "qr/src/**/*.ts",
    "ui/src/**/*.tsx",
    "ui/src/**/*.ts",
    "vite.config.ts"
  ]
}
