{
  "name": "@boxvault/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite",
    "build": "tsc -b && node scripts/prepare-assets.mjs && vite build && vite build --ssr src/seo/prerender.tsx --mode prerender --outDir .prerender && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@boxvault/assets": "workspace:*",
    "bootstrap": "^5.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0"
  }
}
