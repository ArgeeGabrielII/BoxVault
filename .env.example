# Manual development placeholders only; prefer pnpm dev:local for the isolated local app.
# AWS is the hosted target: private RDS, separate content/auth/migration identities.
# Never copy real database URLs or secret values into Git. Hosted values resolve at runtime.
DATABASE_URL="postgresql://CONTENT_RUNTIME:PASSWORD@RDS_PRIVATE_ENDPOINT:5432/boxvault?sslmode=require"
AUTH_DATABASE_URL="postgresql://AUTH_RUNTIME:PASSWORD@RDS_PRIVATE_ENDPOINT:5432/boxvault?sslmode=require"
DIRECT_URL="postgresql://MIGRATION_USER:PASSWORD@RDS_PRIVATE_ENDPOINT:5432/boxvault?sslmode=require"
PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Daily credentials and safe refresh: docs/deployment/secret-rotation.md
# No AWS credentials or secret values belong in VITE_* variables.
