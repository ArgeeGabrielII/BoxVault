{
  "name": "boxvault",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev:web": "pnpm --filter @boxvault/web dev",
    "dev:api": "pnpm --filter @boxvault/api start:dev",
    "build": "pnpm --filter @boxvault/web build && pnpm --filter @boxvault/api build",
    "typecheck": "pnpm --filter @boxvault/web typecheck && pnpm --filter @boxvault/api typecheck",
    "db:generate": "pnpm --filter @boxvault/api db:generate",
    "db:migrate": "pnpm --filter @boxvault/api db:migrate",
    "dev:playground": "pnpm --filter @boxvault/playground dev",
    "build:playground": "pnpm --filter @boxvault/playground build"
  }
}
