{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM bootstrap only: separate BoxVault application deployment role and workload boundary. Does not deploy application resources or change the read-only toolkit.",
  "Rules": {
    "CorrectProject": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::AccountId"
              },
              "666734238831"
            ]
          },
          "AssertDescription": "Use only the verified BoxVault project."
        },
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "ap-southeast-2"
            ]
          },
          "AssertDescription": "Bootstrap only in Sydney."
        }
      ]
    }
  },
  "Resources": {
    "WorkloadBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "BoxVaultAppWorkloadBoundary",
        "Path": "/boxvault/app/",
        "Description": "Maximum envelope only; each execution role requires its separate least-privilege inline policy. No IAM, plan upgrades or human access.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyOtherWorkloadActions",
              "Effect": "Deny",
              "NotAction": [
                "ec2:AssignPrivateIpAddresses",
                "ec2:CreateNetworkInterface",
                "ec2:DeleteNetworkInterface",
                "ec2:DescribeNetworkInterfaces",
                "ec2:DescribeSubnets",
                "ec2:UnassignPrivateIpAddresses",
                "logs:CreateLogStream",
                "logs:PutLogEvents",
                "s3:DeleteObject",
                "s3:GetObject",
                "s3:GetObjectVersion",
                "s3:PutObject",
                "secretsmanager:DescribeSecret",
                "secretsmanager:GetRandomPassword",
                "secretsmanager:GetSecretValue",
                "secretsmanager:PutSecretValue",
                "secretsmanager:UpdateSecretVersionStage",
                "ses:SendEmail",
                "kms:Decrypt"
              ],
              "Resource": "*"
            },
            {
              "Sid": "SydneyOnly",
              "Effect": "Deny",
              "Action": "*",
              "Resource": "*",
              "Condition": {
                "StringNotEquals": {
                  "aws:RequestedRegion": "ap-southeast-2"
                }
              }
            },
            {
              "Sid": "ApplicationLogs",
              "Effect": "Allow",
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Resource": [
                "arn:aws:logs:ap-southeast-2:666734238831:log-group:/aws/lambda/boxvault-app-*:*"
              ]
            },
            {
              "Sid": "PrivateVpcNetworkInterfaces",
              "Effect": "Allow",
              "Action": [
                "ec2:CreateNetworkInterface",
                "ec2:DescribeNetworkInterfaces",
                "ec2:DescribeSubnets",
                "ec2:DeleteNetworkInterface",
                "ec2:AssignPrivateIpAddresses",
                "ec2:UnassignPrivateIpAddresses"
              ],
              "Resource": "*"
            },
            {
              "Sid": "ApplicationSecrets",
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:DescribeSecret",
                "secretsmanager:PutSecretValue",
                "secretsmanager:UpdateSecretVersionStage"
              ],
              "Resource": [
                "arn:aws:secretsmanager:ap-southeast-2:666734238831:secret:boxvault/app/*",
                "arn:aws:secretsmanager:ap-southeast-2:666734238831:secret:rds!db-*"
              ]
            },
            {
              "Sid": "GenerateRotationPassword",
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetRandomPassword"
              ],
              "Resource": "*"
            },
            {
              "Sid": "TemporarySesSender",
              "Effect": "Allow",
              "Action": [
                "ses:SendEmail"
              ],
              "Resource": {
                "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/${TemporarySenderEmail}"
              }
            },
            {
              "Sid": "PrivateMedia",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
              ],
              "Resource": "arn:aws:s3:::boxvault-666734238831-app-media/*"
            },
            {
              "Sid": "MigrationArtifacts",
              "Effect": "Allow",
              "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
              ],
              "Resource": "arn:aws:s3:::boxvault-666734238831-app-artifacts/*"
            },
            {
              "Sid": "DecryptThroughRegionalSecretsManagerOnly",
              "Effect": "Allow",
              "Action": [
                "kms:Decrypt"
              ],
              "Resource": "arn:aws:kms:ap-southeast-2:666734238831:key/*",
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "secretsmanager.ap-southeast-2.amazonaws.com",
                  "kms:CallerAccount": "666734238831"
                }
              }
            }
          ]
        }
      }
    },
    "DeploymentBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "BoxVaultAppDeploymentBoundary",
        "Path": "/boxvault/deployment/",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
